# ROS2 / colcon build output (in any package or workspace level)
**/build/
**/install/
**/log/
**/.colcon/
**/compile_commands.json
**/colcon_command_prefix_setup_py.sh
**/colcon_command_prefix_build.sh
**/colcon.pkg

# Python virtual environments
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/
*/env/
*/ENV/
*/lib/python*/
*/lib64/python*/
*/site-packages/

# Python cache
**/__pycache__/
**/.pytest_cache/
*.pyc
*.pyo
*.pyd

# Python package cache
*.egg-info/
.eggs/
dist/

# CMake / C++ temporary files
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
*.o
*.a
*.out

# Editor temporary files
*.swp
*.swo
*.swn

# AI / model files
*.onnx
*.engine
*.weights
*.tflite
*.h5

# ROS bag / database files
*.bag
*.db3
*.mcap

# Dataset / training output
datasets/
dataset/
runs/
wandb/
outputs/
checkpoints/

# Compressed files
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Media files
*.mp4
*.avi
*.mov
*.mkv

# VS Code cache
.vscode/ipch/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json

# System files
.DS_Store
Thumbs.db

# The CAN vendor shared objects below are source inputs, not build output.
# Keep them versioned so a clone can compile can_bridge and wtb_car_driver.
# There is intentionally no broad *.so rule, so these architecture-specific files
# remain visible to Git and can be committed with the source tree.
