<?xml version="1.0"?>
<robot name="wtb_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="1.45"/>
  <xacro:property name="base_width" value="0.75"/>
  <xacro:property name="base_height" value="1.35"/>
  <xacro:property name="base_z" value="0.20"/>
  <xacro:property name="wheel_radius" value="0.20"/>
  <xacro:property name="wheel_length" value="0.12"/>
  <xacro:property name="wheel_x" value="0.35"/>
  <xacro:property name="wheel_y" value="0.43"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${mass*(x*x+z*z)/12}" iyz="0"
               izz="${mass*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}_link">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
        <material name="wtb_black"><color rgba="0.05 0.05 0.05 1"/></material>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
      </collision>
      <inertial>
        <mass value="3.0"/>
        <inertia ixx="0.0636" ixy="0" ixz="0" iyy="0.0636" iyz="0" izz="0.0216"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="rear_wheel" params="name x y">
    <xacro:wheel_link name="${name}"/>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_link"/>
      <origin xyz="${x} ${y} ${-base_height/2}"/>
      <axis xyz="0 1 0"/>
      <limit effort="500" velocity="20"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="front_wheel" params="name x y">
    <link name="${name}_steer_link">
      <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
    <joint name="${name}_steer_joint" type="revolute">
      <parent link="base_link"/><child link="${name}_steer_link"/>
      <origin xyz="${x} ${y} ${-base_height/2}"/>
      <axis xyz="0 0 1"/>
      <limit effort="500" velocity="2" lower="-0.6109" upper="0.6109"/>
      <dynamics damping="1"/>
    </joint>
    <xacro:wheel_link name="${name}"/>
    <joint name="${name}_joint" type="continuous">
      <parent link="${name}_steer_link"/><child link="${name}_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="500" velocity="20"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wtb_car">
    <link name="base_footprint"/>
    <link name="base_link">
      <visual>
        <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
        <material name="wtb_white"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry></collision>
      <xacro:box_inertial mass="90" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </link>
    <joint name="base_link_joint" type="fixed">
      <parent link="base_footprint"/><child link="base_link"/>
      <origin xyz="0 0 ${base_z + base_height/2}"/>
    </joint>

    <xacro:front_wheel name="left_front" x="${wheel_x}" y="${wheel_y}"/>
    <xacro:front_wheel name="right_front" x="${wheel_x}" y="${-wheel_y}"/>
    <xacro:rear_wheel name="left_wheel" x="${-wheel_x}" y="${wheel_y}"/>
    <xacro:rear_wheel name="right_wheel" x="${-wheel_x}" y="${-wheel_y}"/>

    <link name="laser">
      <visual><geometry><cylinder radius="0.08" length="0.15"/></geometry><material name="wtb_gray"><color rgba="0.5 0.5 0.5 1"/></material></visual>
      <collision><geometry><cylinder radius="0.08" length="0.15"/></geometry></collision>
      <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/><child link="laser"/><origin xyz="0.4 0 0.725"/>
    </joint>

    <link name="gyro_link">
      <visual><geometry><box size="0.1 0.1 0.01"/></geometry><material name="wtb_gray"/></visual>
      <collision><geometry><box size="0.1 0.1 0.01"/></geometry></collision>
      <xacro:box_inertial mass="0.1" x="0.1" y="0.1" z="0.01"/>
    </link>
    <joint name="IMU_joint" type="fixed">
      <parent link="base_link"/><child link="gyro_link"/><origin xyz="0 0 -0.4"/>
    </joint>
  </xacro:macro>

  <xacro:wtb_car/>
</robot>
