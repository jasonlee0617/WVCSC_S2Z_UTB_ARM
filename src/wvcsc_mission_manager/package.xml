<?xml version="1.0"?>
<!-- 中文说明：全流程 MissionManager 的 ROS 依赖与 Python 节点安装声明。 -->
<package format="3">
  <name>wvcsc_mission_manager</name>
  <version>0.1.0</version>
  <description>Mission state machine for YAML/RViz tasks, Nav2 and Alicia-M coordination.</description>
  <maintainer email="robot@example.com">robot</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>wvcsc_interfaces</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
