<?xml version="1.0"?>
<!-- 中文说明：视觉伺服节点、纯控制算法和 MoveIt Servo 配置的 ROS 包声明。 -->
<package format="3">
  <name>wvcsc_visual_servo</name>
  <version>0.1.0</version>
  <description>Alicia-M RGB image-based visual servo using MoveIt Servo.</description>
  <maintainer email="robot@example.com">robot</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>wvcsc_interfaces</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
