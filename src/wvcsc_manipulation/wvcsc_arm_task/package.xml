<?xml version="1.0"?>
<!-- 中文说明：Alicia-M 观察、视觉对准和喷洒 Action 节点包的依赖声明。 -->
<package format="3">
  <name>wvcsc_arm_task</name>
  <version>0.1.0</version>
  <description>Alicia-M observation and simulated spraying task.</description>
  <maintainer email="robot@example.com">robot</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>pymoveit2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_retime_server</exec_depend>
  <exec_depend>wvcsc_interfaces</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
