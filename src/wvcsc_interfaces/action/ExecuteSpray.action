# 顶层单株机械臂喷洒 Action。MissionManager 仅在 INSPECT Point 的 Nav2 目标到达且
# 车辆经里程计确认停稳后发送；独立机械臂 Qt 也是客户端。SprayTask 是唯一服务端，按顺序
# 负责观察位、病态目标检测、瞄准、视觉伺服、喷嘴喷洒、复检剩余目标和最终 HOME。
# 它不携带路线 Point ID；路线调度归 MissionManager 所有，机械臂只接收本次任务的几何提示。
# Goal 被接受不表示整株喷洒已成功，最终语义以 Result 为准。
# Goal: 单株任务关联、每个病态目标的喷洒时长和观察/几何设置。
string mission_id                     # 路线或独立单臂测试标识符，用于感知与子 Action 关联。
float32 spray_duration                # 每个选中病态目标的喷嘴开启秒数，不是整株累计时长。
# 植物根部的几何提示点。frame_id 必须明确；完整路线通常使用 map，独立测试可使用 alicia_base_link。
geometry_msgs/PointStamped tree_hint
# 可选观察模式覆盖。空字符串使用 SprayTask 配置；当前约定值为 ik 或 joint_presets。
string observation_mode
# 可选喷嘴瞄准工作距离（米）。0 表示采用正常自动几何计算；正值仅供独立单臂测试手动覆盖，
# 不会反写完整路线的任务数据。
float32 working_range_m
---
# Result: success 可表示“全部处理”“检查完成但无病态目标”或“部分处理”。调用方必须结合
# error_code 和 message 判断覆盖范围；服务端拒绝的 Goal 不会产生自定义 Result。
uint16 OK=0                           # 所有选中的病态目标均已完成处理。
uint16 INVALID_GOAL=1                 # mission_id、时长、坐标系或其他 Goal 参数无效。
uint16 BUSY=2                         # SprayTask 已有激活的 ExecuteSpray Goal。
uint16 LOCKED=3                       # 机械臂安全锁阻止执行。
uint16 OBSERVE_FAILED=4               # 观察位姿阶段未成功完成。
uint16 CANCELED=5                     # 取消/终止的安全清理与复位路径已完成。
uint16 HOME_FAILED=6                  # 最终 HOME/复位阶段失败，属于硬故障。
uint16 INTERNAL_ERROR=7               # 未预期的任务编排异常。
uint16 VISION_FAILED=8                # 当前植株没有可用的感知输入或目标数据。
uint16 SPRAY_FAILED=9                 # 病态目标无法完成喷洒。
uint16 INSPECTED_NO_DISEASE=10        # 检查完成，未发现符合配置的病态目标。
uint16 PARTIAL_SUCCESS=11             # 至少一个目标已处理，其余目标未解决。
bool success                           # 对 OK、INSPECTED_NO_DISEASE、PARTIAL_SUCCESS 为 True。
uint16 error_code                      # 上述数值错误码；不得改变既有常量值。
string message                         # 供日志和 UI 显示的结果统计/诊断文本。
---
# Feedback: 任务阶段和进度，供 MissionManager 与机械臂 Qt 使用。
uint8 ACCEPTED=0                       # 保留的兼容阶段；当前实现不发布该阶段。
uint8 MOVING_TO_OBSERVE=1              # 正在移动到配置的观察位姿。
# 数值 2 因已删除的旧树扫描阶段而有意保留，不能复用。
uint8 DETECTING_TARGETS=3              # 正在收集或刷新病态目标。
uint8 QUEUING=4                        # 正在更新目标账本与待处理队列。
uint8 ALIGNING=5                       # 正在为当前病态目标调用 AlignTarget。
uint8 SPRAYING=6                       # SprayActuator 正占用继电器通道 2 进行定时喷洒。
uint8 RETURNING_TO_OBSERVE=7           # 正在回观察位复检剩余目标。
uint8 RETURNING_HOME=8                 # 整株结束或安全清理时正在 HOME。
uint8 COMPLETED=9                      # 返回 Result 前的终端反馈阶段。
uint8 phase                            # 当前反馈阶段常量。
float32 progress                       # UI 进度提示；不保证严格单调递增。
string phase_text                      # 人类可读的阶段详情。
