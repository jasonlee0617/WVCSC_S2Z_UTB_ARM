# Goal
string mission_id
string tree_id
string target_id
float32 timeout
# Contract shared with the MoveIt recenter stage.  The target must be aligned
# to the calibrated nozzle-axis projection, never to an implicit image centre.
float32 working_range_m
float32 desired_u_px
float32 desired_v_px
uint32 image_width
uint32 image_height
---
# Result
uint16 OK=0
uint16 INVALID_GOAL=1
uint16 BUSY=2
uint16 TIMEOUT=3
uint16 TARGET_STALE=4
uint16 CANCELED=5
uint16 SERVO_SINGULARITY=6
uint16 SERVO_SAFETY_STOP=7
uint16 SERVO_ACTUATION_STALL=8
uint16 SERVO_DIRECTION_DIVERGENCE=9
bool success
uint16 error_code
string message
float32 final_error_u
float32 final_error_v
---
# Feedback
uint8 ACQUIRING=0
uint8 ALIGNED=1
uint8 phase
float32 error_u
float32 error_v
uint32 stable_frames
