# 视觉伺服闭环对准 Action。SprayTask 在选定一个 Target2D、并经 ComputeSprayAim
# 得到校准后的喷嘴轴线像素点后调用；wvcsc_visual_servo 是服务端。
# Goal 被接受后会开始受限的机械臂运动。调用方必须先完成观察位、目标有效性和任务级
# 安全前置检查；本 Action 仍保留碰撞、限位和奇异性等硬安全停止。
# 该 Action 只对齐一个病态视觉目标，不携带路线 Point ID 或植物 ID。
# Goal: 本次闭环的关联标识、时间限制和图像平面输入。
string mission_id                    # ExecuteSpray/独立测试的任务关联 ID；用于拒绝其他任务的旧图像。
string target_id                     # 当前感知会话内唯一且稳定的病态目标追踪 ID；须与 Target2D 一致。
# 最大闭环持续时间（秒）。0 表示由视觉伺服服务端采用其配置的默认超时；正值覆盖默认值。
float32 timeout
# 喷嘴瞄准工作平面距离（米）。必须为有限正值；与 ExecuteSpray 不同，0 不表示自动计算。
float32 working_range_m
# 当前完整相机图像中期望的喷嘴轴线像素坐标（像素）。
float32 desired_u_px
float32 desired_v_px
# 生成 desired_u_px/desired_v_px 的图像尺寸；服务端据此验证像素范围和计算误差。
uint32 image_width
uint32 image_height
---
# Result: 仅 error_code=OK 时 success=true。服务端拒绝的 Goal 不会产生自定义 Result，
# 客户端必须单独处理 Goal 被拒绝的情况。
uint16 OK=0                          # 目标达到配置的误差公差和稳定帧要求。
uint16 INVALID_GOAL=1                # mission_id、target_id、图像几何或工作距离无效。
uint16 BUSY=2                        # 已有另一个视觉伺服 Goal 处于激活状态。
uint16 TIMEOUT=3                     # 在超时前未达到收敛条件。
uint16 TARGET_STALE=4                # 对应 Target2D 图像数据过期、失效或不可用。
uint16 CANCELED=5                    # 客户端取消后，停止与清理已完成。
uint16 SERVO_SINGULARITY=6           # 触发机械臂硬运动学奇异性保护。
uint16 SERVO_SAFETY_STOP=7           # 触发碰撞、限位或其他硬安全停止。
uint16 SERVO_ACTUATION_STALL=8       # 控制器在视觉伺服命令后停止响应。
uint16 SERVO_DIRECTION_DIVERGENCE=9  # 图像误差持续向错误方向发展。
bool success                          # 仅当 error_code=OK 时为 True。
uint16 error_code                     # 上述数值错误码；不得改变既有常量值。
string message                        # 供日志和 UI 显示的诊断文本，不应作为机器解析协议。
float32 final_error_u                 # 结束时的水平图像误差（像素）。
float32 final_error_v                 # 结束时的垂直图像误差（像素）。
---
# Feedback: 仅在已接受的闭环期间发布。
uint8 ACQUIRING=0                     # 正在等待与 mission_id/target_id 匹配的有效当前图像帧。
uint8 ALIGNED=1                       # 图像误差已进入公差，正在累计稳定帧；不等同于 Action 已成功返回。
uint8 phase                           # 当前反馈阶段常量。
float32 error_u                       # 当前水平图像误差（像素）。
float32 error_v                       # 当前垂直图像误差（像素）。
uint32 stable_frames                  # 连续处于公差范围内的已观测帧数。
