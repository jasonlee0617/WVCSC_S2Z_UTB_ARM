<?xml version="1.0"?>
<!-- 中文说明：统一车辆、传感器和 Alicia-M 模型描述包的 ROS 依赖与资源安装声明。 -->
<package format="3">
  <name>wvcsc_description</name>
  <version>0.1.0</version>
  <description>Unified WVCSC Ackermann vehicle and Alicia-M robot description.</description>
  <maintainer email="robot@example.com">robot</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>alicia_m_descriptions</exec_depend>
  <exec_depend>alicia_m_moveit_config</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>wtb_car_driver</exec_depend>
  <exec_depend>wvcsc_c10_camera</exec_depend>
  <exec_depend>xacro</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
