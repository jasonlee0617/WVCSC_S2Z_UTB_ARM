<?xml version="1.0"?>
<robot name="wvcsc_utb_alicia" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="enable_arm_control" default="true"/>
  <xacro:arg name="enable_ackermann" default="true"/>
  <xacro:arg name="enable_gazebo_ros2_control" default="false"/>
  <xacro:arg name="gazebo_controllers_file" default="$(find wvcsc_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="ros2_control_plugin" default="mock_components/GenericSystem"/>
  <xacro:arg name="initial_positions_file" default="$(find alicia_m_moveit_config)/config/initial_positions.yaml"/>
  <xacro:arg name="serial_port" default="/dev/ttyACM0"/>
  <xacro:arg name="baudrate" default="1000000"/>
  <xacro:arg name="control_mode" default="pv"/>
  <xacro:arg name="default_speed" default="1.0"/>
  <xacro:arg name="mit_kp" default="50.0"/>
  <xacro:arg name="mit_kd" default="2.0"/>

  <!-- Model geometry remains owned by the original vehicle and arm descriptions. -->
  <xacro:include filename="$(find wtb_car_driver)/urdf/wtb_car.xacro"/>
  <xacro:include filename="$(find alicia_m_descriptions)/urdf/Alicia_M_v1_1/Alicia_M_v1_1_follower.urdf"/>
  <xacro:include filename="$(find alicia_m_moveit_config)/config/alicia_m_v1_1_follower.ros2_control.xacro"/>

  <link name="arm_mount_link">
    <visual><geometry><box size="0.24 0.24 0.12"/></geometry><material name="mount_gray"><color rgba="0.3 0.3 0.3 1"/></material></visual>
    <collision><geometry><box size="0.24 0.24 0.12"/></geometry></collision>
    <inertial><mass value="5"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.012"/></inertial>
  </link>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/><child link="arm_mount_link"/><origin xyz="0 0 0.56"/>
  </joint>
  <joint name="alicia_mount_joint" type="fixed">
    <parent link="arm_mount_link"/><child link="alicia_base_link"/><origin xyz="0 0 0.06"/>
  </joint>

  <xacro:if value="$(arg enable_arm_control)">
    <xacro:alicia_m_v1_1_follower_ros2_control
      name="AliciaHardware"
      initial_positions_file="$(arg initial_positions_file)"
      ros2_control_plugin="$(arg ros2_control_plugin)"
      serial_port="$(arg serial_port)"
      baudrate="$(arg baudrate)"
      control_mode="$(arg control_mode)"
      default_speed="$(arg default_speed)"
      mit_kp="$(arg mit_kp)"
      mit_kd="$(arg mit_kd)"/>
  </xacro:if>

  <gazebo reference="laser">
    <sensor name="laser" type="ray">
      <always_on>true</always_on><update_rate>10</update_rate><visualize>true</visualize>
      <ray>
        <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal></scan>
        <range><min>0.15</min><max>20</max><resolution>0.02</resolution></range>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type><frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_ackermann)">
    <gazebo>
      <plugin name="vehicle_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
        <update_rate>50.0</update_rate>
        <joint_name>left_front_steer_joint</joint_name>
        <joint_name>left_front_joint</joint_name>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_front_steer_joint</joint_name>
        <joint_name>right_front_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg enable_gazebo_ros2_control)">
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>$(arg gazebo_controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
