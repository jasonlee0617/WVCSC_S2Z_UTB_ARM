<?xml version="1.0"?>
<robot name="wvcsc_utb_alicia" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="enable_arm_control" default="true"/>
  <xacro:arg name="enable_ackermann" default="true"/>
  <xacro:arg name="enable_gazebo_ros2_control" default="false"/>
  <xacro:arg name="enable_c10_camera" default="true"/>
  <xacro:arg name="enable_c10_gazebo" default="false"/>
  <xacro:arg name="c10_noise_stddev" default="0.007"/>
  <xacro:arg name="calibration_fix_base" default="false"/>

    <!-- 机械臂车顶安装参数 -->
  <!--
    Alicia 原始 URDF 默认把机械臂底座命名为 base_link，
    会与小车 base_link 重名，因此覆盖为 alicia_base_link。
  -->
  <xacro:arg name="alicia_base_link" default="alicia_base_link"/>
  <!--
    小车车体高度为 1.35 m，base_link 位于车体几何中心，
    因此车顶相对 base_link 的 Z 坐标为 1.35 / 2 = 0.675 m。
  -->
  <xacro:arg name="vehicle_roof_z" default="0.675"/>
  <!--
    机械臂相对于车顶安装坐标系的位置：
    沿 base_link 负 X 方向平移 0.40 m。
  -->
  <xacro:arg name="arm_mount_xyz" default="-0.40 0 0"/>
  <!--
    绕 Z 轴旋转 180°，使机械臂底座 X 轴方向反转，
    同时保持机械臂 Z 轴朝上。
  -->
  <xacro:arg
    name="arm_mount_rpy"
    default="0 0 3.141592653589793"/>

  <!-- Temporary eye-in-hand extrinsics. Recalibrate after the real bracket is fixed. -->
  <xacro:arg name="c10_mount_xyz" default="-0.055 0 -0.10"/>
  <xacro:arg name="c10_mount_rpy" default="0 -1.57079632679 0"/>
  <!-- Calibrated spray origin; local +Z is the liquid centreline. -->
  <xacro:arg name="nozzle_mount_xyz" default="0 0 0"/>
  <xacro:arg name="nozzle_mount_rpy" default="0 0 0"/>
  <xacro:arg name="gazebo_controllers_file" default="$(find wvcsc_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="ros2_control_plugin" default="mock_components/GenericSystem"/>
  <xacro:arg name="initial_positions_file" default="$(find alicia_m_moveit_config)/config/initial_positions.yaml"/>
  <xacro:arg name="serial_port" default="/dev/ttyACM0"/>
  <xacro:arg name="baudrate" default="1000000"/>
  <xacro:arg name="control_mode" default="pv"/>
  <xacro:arg name="default_speed" default="1.0"/>
  <xacro:arg name="mit_kp" default="50.0"/>
  <xacro:arg name="mit_kd" default="2.0"/>

  <!-- Model geometry remains owned by the original vehicle and arm descriptions. -->
  <xacro:include filename="$(find wtb_car_driver)/urdf/wtb_car.xacro"/>
  <xacro:include filename="$(find alicia_m_descriptions)/urdf/Alicia_M_v1_1/Alicia_M_v1_1_follower.urdf"/>
  <xacro:include filename="$(find alicia_m_moveit_config)/config/alicia_m_v1_1_follower.ros2_control.xacro"/>

  <xacro:if value="$(arg calibration_fix_base)">
    <link name="world"/>
    <joint name="world_to_base_footprint" type="fixed">
      <parent link="world"/>
      <child link="base_footprint"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!--
    车顶安装坐标系。
    wtb_car.xacro 中：
      base_height = 1.35 m
    base_link 位于车体几何中心，所以车顶位置为：
      Z = 1.35 / 2 = 0.675 m
  -->
  <link name="arm_mount_link"/>

  <joint name="arm_mount_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_mount_link"/>

    <!-- arm_mount_link 原点位于小车车顶表面 -->
    <origin
      xyz="0 0 $(arg vehicle_roof_z)"
      rpy="0 0 0"/>
  </joint>
  <!--
    机械臂与车顶安装坐标系之间的固定连接。
    xyz="-0.40 0 0"：
      沿 base_link 负 X 方向移动 0.40 m。
    rpy="0 0 pi"：
      绕 Z 轴旋转 180°，机械臂底座 X 轴反向，
      机械臂 Z 轴仍然保持朝上。
  -->
  <joint name="alicia_mount_joint" type="fixed">
    <parent link="arm_mount_link"/>
    <child link="$(arg alicia_base_link)"/>

    <origin
      xyz="$(arg arm_mount_xyz)"
      rpy="$(arg arm_mount_rpy)"/>
  </joint>

  <!-- 车顶广域喷洒柱：底面中心位于 base_link (0.10, 0, 0.675)。
       该模型既是 Gazebo 中的广域喷洒出雾原点，也是 MoveIt 必须避开的
       自碰撞实体；+Z 为柱体和环喷的轴线方向。 -->
  <link name="wide_sprayer_link">
    <visual>
      <origin xyz="0 0 0.250" rpy="0 0 0"/>
      <geometry><cylinder radius="0.030" length="0.500"/></geometry>
      <material name="wide_sprayer_blue"><color rgba="0.08 0.24 0.34 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.500" rpy="0 0 0"/>
      <geometry><cylinder radius="0.034" length="0.012"/></geometry>
      <material name="wide_sprayer_cap"><color rgba="0.30 0.72 0.78 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.255" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.510"/></geometry>
    </collision>
  </link>
  <joint name="wide_sprayer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wide_sprayer_link"/>
    <origin xyz="0.10 0 $(arg vehicle_roof_z)" rpy="0 0 0"/>
  </joint>

  <!-- tool0 即当前喷嘴安装基准；局部 +Z 为喷流中心轴。使用三级圆柱形成
       紧凑的中空喷嘴外观，碰撞包络只略大于真实外观。 -->
  <link name="spray_nozzle_link">
    <visual>
      <origin xyz="0 0 0.004" rpy="0 0 0"/>
      <geometry><cylinder radius="0.011" length="0.008"/></geometry>
      <material name="nozzle_mount"><color rgba="0.16 0.18 0.20 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.009" length="0.014"/></geometry>
      <material name="nozzle_brass"><color rgba="0.70 0.48 0.12 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.031" rpy="0 0 0"/>
      <geometry><cylinder radius="0.005" length="0.010"/></geometry>
      <material name="nozzle_exit"><color rgba="0.06 0.06 0.06 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.035"/></geometry>
    </collision>
  </link>
  <joint name="spray_nozzle_joint" type="fixed">
    <parent link="tool0"/>
    <child link="spray_nozzle_link"/>
    <origin xyz="$(arg nozzle_mount_xyz)" rpy="$(arg nozzle_mount_rpy)"/>
  </joint>

  <!--
    C10 eye-in-hand model. camera_link follows Gazebo's +X-forward camera
    convention; camera_color_optical_frame follows REP-103 (+Z forward,
    +X right, +Y down). tool0 is the temporary logical spray point.
  -->
  <xacro:if value="$(arg enable_c10_camera)">
    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://wvcsc_description/meshes/c10/camera.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.070 0.040 0.025"/></geometry>
      </collision>
      <inertial>
        <mass value="0.130"/>
        <inertia ixx="0.000020" ixy="0" ixz="0"
                 iyy="0.000055" iyz="0" izz="0.000060"/>
      </inertial>
    </link>
    <joint name="c10_mount_joint" type="fixed">
      <parent link="tool0"/>
      <child link="camera_link"/>
      <origin xyz="$(arg c10_mount_xyz)" rpy="$(arg c10_mount_rpy)"/>
    </joint>

    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <xacro:if value="$(arg enable_c10_gazebo)">
      <!-- Keep Gazebo rendering tied to the same measured C10 calibration
           used by the real usb_cam driver. -->
      <xacro:property name="c10_calibration" value="${xacro.load_yaml('$(find wvcsc_c10_camera)/config/c10_intrinsics.yaml')}"/>
      <xacro:property name="c10_width" value="${c10_calibration['image_width']}"/>
      <xacro:property name="c10_height" value="${c10_calibration['image_height']}"/>
      <xacro:property name="c10_fx" value="${c10_calibration['camera_matrix']['data'][0]}"/>
      <xacro:property name="c10_fy" value="${c10_calibration['camera_matrix']['data'][4]}"/>
      <xacro:property name="c10_cx" value="${c10_calibration['camera_matrix']['data'][2]}"/>
      <xacro:property name="c10_cy" value="${c10_calibration['camera_matrix']['data'][5]}"/>
      <xacro:property name="c10_k1" value="${c10_calibration['distortion_coefficients']['data'][0]}"/>
      <xacro:property name="c10_k2" value="${c10_calibration['distortion_coefficients']['data'][1]}"/>
      <xacro:property name="c10_p1" value="${c10_calibration['distortion_coefficients']['data'][2]}"/>
      <xacro:property name="c10_p2" value="${c10_calibration['distortion_coefficients']['data'][3]}"/>
      <xacro:property name="c10_k3" value="${c10_calibration['distortion_coefficients']['data'][4]}"/>
      <!-- Gazebo lumps fixed camera_link into link6, so attach its sensor to
           the retained parent link with the equivalent fixed transform. -->
      <gazebo reference="link6">
        <sensor name="c10_color" type="camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <visualize>false</visualize>
          <pose>-0.055 0 0.05 0 -1.57079632679 0</pose>
          <camera name="c10_optical">
            <horizontal_fov>${2.0 * atan(c10_width / (2.0 * c10_fx))}</horizontal_fov>
            <image>
              <width>${c10_width}</width>
              <height>${c10_height}</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.02</near><far>300</far></clip>
            <distortion>
              <k1>${c10_k1}</k1><k2>${c10_k2}</k2><k3>${c10_k3}</k3>
              <p1>${c10_p1}</p1><p2>${c10_p2}</p2>
              <center>${c10_cx / c10_width} ${c10_cy / c10_height}</center>
            </distortion>
            <lens>
              <intrinsics>
                <fx>${c10_fx}</fx><fy>${c10_fy}</fy>
                <cx>${c10_cx}</cx><cy>${c10_cy}</cy><s>0</s>
              </intrinsics>
            </lens>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>$(arg c10_noise_stddev)</stddev></noise>
          </camera>
          <plugin name="c10_camera_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/camera</namespace>
              <qos>
                <topic name="color/image_raw">
                  <publisher>
                    <reliability>best_effort</reliability>
                    <history depth="1">keep_last</history>
                  </publisher>
                </topic>
                <topic name="color/camera_info">
                  <publisher>
                    <reliability>best_effort</reliability>
                    <history depth="1">keep_last</history>
                  </publisher>
                </topic>
              </qos>
            </ros>
            <camera_name>color</camera_name>
            <frame_name>camera_color_optical_frame</frame_name>
            <!-- gazebo_ros_camera publishes K with one focal length; retain
                 measured fy in P while rendering uses the full fx/fy pair. -->
            <focal_length>${c10_fx}</focal_length>
            <cx>${c10_cx}</cx><cy>${c10_cy}</cy>
            <P_fx>${c10_fx}</P_fx><P_fy>${c10_fy}</P_fy>
            <P_cx>${c10_cx}</P_cx><P_cy>${c10_cy}</P_cy>
            <border_crop>false</border_crop>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:if>

  <xacro:if value="$(arg enable_arm_control)">
    <xacro:alicia_m_v1_1_follower_ros2_control
      name="AliciaHardware"
      initial_positions_file="$(arg initial_positions_file)"
      ros2_control_plugin="$(arg ros2_control_plugin)"
      serial_port="$(arg serial_port)"
      baudrate="$(arg baudrate)"
      control_mode="$(arg control_mode)"
      default_speed="$(arg default_speed)"
      mit_kp="$(arg mit_kp)"
      mit_kd="$(arg mit_kd)"/>
  </xacro:if>

  <gazebo reference="laser">
    <sensor name="laser" type="ray">
      <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <ray>
        <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-1.047</min_angle><max_angle>1.047</max_angle></horizontal></scan>
        <range><min>0.15</min><max>20</max><resolution>0.02</resolution></range>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type><frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_ackermann)">
    <gazebo>
      <plugin name="vehicle_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
        <update_rate>50.0</update_rate>
        <joint_name>left_front_steer_joint</joint_name>
        <joint_name>left_front_joint</joint_name>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_front_steer_joint</joint_name>
        <joint_name>right_front_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg enable_gazebo_ros2_control)">
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>$(arg gazebo_controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
