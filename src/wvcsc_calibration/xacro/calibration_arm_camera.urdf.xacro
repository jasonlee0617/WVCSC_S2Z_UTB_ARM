<?xml version="1.0"?>
<robot name="alicia_calibration" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- LEGACY REFERENCE ONLY: Alicia-M arm + C10 camera on a desk.
       calibration_sim.launch.py no longer starts this model because it lacks
       the vehicle roof mount and chassis collision geometry. Keep it for
       documented rollback/reference, not one-to-one vehicle validation. -->

  <xacro:arg name="alicia_base_link" default="alicia_base_link"/>
  <xacro:arg name="c10_mount_xyz" default="-0.055 0 -0.10"/>
  <xacro:arg name="c10_mount_rpy" default="0 -1.57079632679 0"/>

  <!--
    Keep the Gazebo model pose and the robot TF tree identical.  The desk
    surface is at z=0.75 m and the Alicia-M mounting plane is 10 mm above it.
    The entity is therefore spawned at the Gazebo origin; this fixed joint
    carries the complete mounting height instead of hiding it in spawn_entity.
  -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="$(arg alicia_base_link)"/>
    <origin xyz="0 0 0.75" rpy="0 0 0"/>
  </joint>

  <!-- Alicia-M arm geometry (joint1–tool0) -->
  <xacro:include filename="$(find alicia_m_descriptions)/urdf/Alicia_M_v1_1/Alicia_M_v1_1_follower.urdf"/>
  <xacro:include filename="$(find alicia_m_moveit_config)/config/alicia_m_v1_1_follower.ros2_control.xacro"/>

  <xacro:arg name="initial_positions_file" default="$(find alicia_m_moveit_config)/config/initial_positions.yaml"/>
  <xacro:arg name="gazebo_controllers_file" default="$(find wvcsc_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="ros2_control_plugin" default="gazebo_ros2_control/GazeboSystem"/>
  <xacro:property name="c10_calibration" value="${xacro.load_yaml('$(find wvcsc_c10_camera)/config/c10_intrinsics.yaml')}"/>
  <xacro:property name="c10_width" value="${c10_calibration['image_width']}"/>
  <xacro:property name="c10_height" value="${c10_calibration['image_height']}"/>
  <xacro:property name="c10_fx" value="${c10_calibration['camera_matrix']['data'][0]}"/>
  <xacro:property name="c10_fy" value="${c10_calibration['camera_matrix']['data'][4]}"/>
  <xacro:property name="c10_cx" value="${c10_calibration['camera_matrix']['data'][2]}"/>
  <xacro:property name="c10_cy" value="${c10_calibration['camera_matrix']['data'][5]}"/>
  <xacro:property name="c10_k1" value="${c10_calibration['distortion_coefficients']['data'][0]}"/>
  <xacro:property name="c10_k2" value="${c10_calibration['distortion_coefficients']['data'][1]}"/>
  <xacro:property name="c10_p1" value="${c10_calibration['distortion_coefficients']['data'][2]}"/>
  <xacro:property name="c10_p2" value="${c10_calibration['distortion_coefficients']['data'][3]}"/>
  <xacro:property name="c10_k3" value="${c10_calibration['distortion_coefficients']['data'][4]}"/>

  <xacro:alicia_m_v1_1_follower_ros2_control
    name="AliciaHardware"
    initial_positions_file="$(arg initial_positions_file)"
    ros2_control_plugin="$(arg ros2_control_plugin)"
    serial_port="/dev/null"
    baudrate="1000000"
    control_mode="pv"
    default_speed="1.0"
    mit_kp="50.0"
    mit_kd="2.0"/>

  <!-- C10 eye-in-hand camera on tool0 -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://wvcsc_description/meshes/c10/camera.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.130"/>
      <inertia ixx="0.000020" ixy="0" ixz="0" iyy="0.000055" iyz="0" izz="0.000060"/>
    </inertial>
  </link>
  <joint name="c10_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_link"/>
    <origin xyz="$(arg c10_mount_xyz)" rpy="$(arg c10_mount_rpy)"/>
  </joint>

  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- Gazebo C10 camera sensor on link6 -->
  <gazebo reference="link6">
    <sensor name="c10_color" type="camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>false</visualize>
      <pose>-0.055 0 0.05 0 -1.57079632679 0</pose>
      <camera name="c10_optical">
        <horizontal_fov>${2.0 * atan(c10_width / (2.0 * c10_fx))}</horizontal_fov>
        <image><width>${c10_width}</width><height>${c10_height}</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
        <distortion>
          <k1>${c10_k1}</k1><k2>${c10_k2}</k2><k3>${c10_k3}</k3>
          <p1>${c10_p1}</p1><p2>${c10_p2}</p2>
          <center>${c10_cx / c10_width} ${c10_cy / c10_height}</center>
        </distortion>
        <lens>
          <intrinsics>
            <fx>${c10_fx}</fx><fy>${c10_fy}</fy>
            <cx>${c10_cx}</cx><cy>${c10_cy}</cy><s>0</s>
          </intrinsics>
        </lens>
        <!-- The calibration scene is a deterministic geometric benchmark.
             Keep sensor noise out of the ground-truth comparison; C10 noise
             belongs in the perception simulation, not the extrinsic oracle. -->
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
      </camera>
      <plugin name="c10_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <qos>
            <topic name="color/image_raw">
              <publisher>
                <reliability>best_effort</reliability>
                <history depth="1">keep_last</history>
              </publisher>
            </topic>
            <topic name="color/camera_info">
              <publisher>
                <reliability>best_effort</reliability>
                <history depth="1">keep_last</history>
              </publisher>
            </topic>
          </qos>
        </ros>
        <camera_name>color</camera_name>
        <frame_name>camera_color_optical_frame</frame_name>
        <focal_length>${c10_fx}</focal_length>
        <cx>${c10_cx}</cx><cy>${c10_cy}</cy>
        <P_fx>${c10_fx}</P_fx><P_fy>${c10_fy}</P_fy>
        <P_cx>${c10_cx}</P_cx><P_cy>${c10_cy}</P_cy>
        <border_crop>false</border_crop>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(arg gazebo_controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
