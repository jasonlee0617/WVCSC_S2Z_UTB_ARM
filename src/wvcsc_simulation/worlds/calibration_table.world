<sdf version="1.6">
  <world name="calibration_table">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ArUco marker: 90×90mm, DICT_5X5_250 id=1, stood upright facing +X -->
    <include>
      <name>aruco_marker</name>
      <pose>0.35 0 0.80 0 1.5708 0</pose>
      <uri>model://aruco_marker</uri>
    </include>

    <!-- Simple desk: 1.0 x 0.8 x 0.02 m, top at z=0.74, centre at origin -->
    <model name="calibration_desk">
      <static>true</static>
      <link name="desk_top">
        <pose>0 0 0.74 0 0 0</pose>
        <collision name="desk_top_collision">
          <geometry><box><size>1.0 0.8 0.02</size></box></geometry>
        </collision>
        <visual name="desk_top_visual">
          <geometry><box><size>1.0 0.8 0.02</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
      <!-- Legs -->
      <link name="leg_fl"><pose> 0.45  0.35 0.37 0 0 0</pose>
        <collision name="leg_fl_collision"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry></collision></link>
      <link name="leg_fr"><pose> 0.45 -0.35 0.37 0 0 0</pose>
        <collision name="leg_fr_collision"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry></collision></link>
      <link name="leg_bl"><pose>-0.45  0.35 0.37 0 0 0</pose>
        <collision name="leg_bl_collision"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry></collision></link>
      <link name="leg_br"><pose>-0.45 -0.35 0.37 0 0 0</pose>
        <collision name="leg_br_collision"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry></collision></link>
    </model>
  </world>
</sdf>
