<sdf version="1.6">
  <world name="calibration_table">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!--
      Hand-eye calibration evaluates camera/TF geometry, not gravity dynamics.
      Keeping gravity at zero lets Gazebo unpause before ros2_control activates
      the arm, so controller spawners receive update cycles without the
      un-actuated arm sagging onto the table.
    -->
    <physics type="ode">
      <gravity>0 0 0</gravity>
    </physics>

    <!--
      ArUco marker backing is 90x90 mm; its coded square is 70x70 mm.
      The physical coded size is intentionally identical to the real marker;
      the deterministic benchmark improves pixel localization through its
      narrower simulated camera FOV instead of faking a different marker.
      The model plane is local XZ, so roll=+pi/2 places the code flat on the
      tabletop with its printable face upward.  x=0.45 m is in front of the
      Alicia-M base and visible from the official calibration seed pose.
    -->
    <include>
      <name>aruco_marker</name>
      <pose>0.0 0.25 0.752 1.5708 0 0</pose>
      <uri>model://aruco_marker</uri>
    </include>

    <!-- Desk surface is z=0.75 m: 1.20 x 0.80 x 0.02 m. -->
    <model name="calibration_desk">
      <static>true</static>
      <link name="desk_top">
        <pose>0 0 0.74 0 0 0</pose>
        <collision name="desk_top_collision">
          <geometry><box><size>1.2 0.8 0.02</size></box></geometry>
        </collision>
        <visual name="desk_top_visual">
          <geometry><box><size>1.2 0.8 0.02</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
      <!-- Each visible leg uses the same geometry as its collision body. -->
      <link name="leg_fl"><pose> 0.55  0.35 0.37 0 0 0</pose>
        <collision name="leg_fl_collision"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry></collision>
        <visual name="leg_fl_visual"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient></material></visual></link>
      <link name="leg_fr"><pose> 0.55 -0.35 0.37 0 0 0</pose>
        <collision name="leg_fr_collision"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry></collision>
        <visual name="leg_fr_visual"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient></material></visual></link>
      <link name="leg_bl"><pose>-0.55  0.35 0.37 0 0 0</pose>
        <collision name="leg_bl_collision"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry></collision>
        <visual name="leg_bl_visual"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient></material></visual></link>
      <link name="leg_br"><pose>-0.55 -0.35 0.37 0 0 0</pose>
        <collision name="leg_br_collision"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry></collision>
        <visual name="leg_br_visual"><geometry><cylinder><radius>0.02</radius><length>0.74</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient></material></visual></link>
    </model>
  </world>
</sdf>
