<sdf version="1.6">
  <world name="calibration">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <!-- ArUco marker: DICT_5X5_250 id=1, 90x90 mm, placed 20 cm in front of arm_mount_link at camera height -->
    <include>
      <name>aruco_marker</name>
      <pose>0.20 0 0.62 0 0 0</pose>
      <uri>model://aruco_marker</uri>
    </include>
  </world>
</sdf>
