<?xml version="1.0"?>
<sdf version="1.6">
  <world name="orchard">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>50.0</update_rate>
    </plugin>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.35 0.45 0.30 1</ambient><diffuse>0.35 0.45 0.30 1</diffuse></material></visual></link></model>
    <physics type="ode"><real_time_update_rate>1000</real_time_update_rate><max_step_size>0.001</max_step_size></physics>
    <model name="left_tree"><static>true</static><pose>3 2 0.75 0 0 0</pose><link name="trunk"><collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry><material><ambient>0.35 0.18 0.05 1</ambient></material></visual></link></model>
    <model name="right_tree"><static>true</static><pose>5 -2 0.75 0 0 0</pose><link name="trunk"><collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry><material><ambient>0.35 0.18 0.05 1</ambient></material></visual></link></model>
    <model name="end_barrier"><static>true</static><pose>7 0 0.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.3 4 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 4 1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual></link></model>
  </world>
</sdf>
